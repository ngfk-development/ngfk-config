    "test:format": "yarn workspaces foreach exec sort-package-json --check && prettier --check **/*"
  },
  "prettier": "@ngfk/config-prettier",
  "devDependencies": {
    "@ngfk/config-prettier": "workspace:*",
    "prettier": "^2.8.4",
    "sort-package-json": "^2.4.1",
    "typescript": "^4.9.5"
  },
  "packageManager": "yarn@3.4.1"
}
